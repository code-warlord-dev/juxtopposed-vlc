msgid "MPEG audio layer I/II/III decoder"
msgstr "Аудиодекодер MPEG audio I/II/III"

#: modules/codec/mft.cpp:82
msgid "Extra MFT Debug"
msgstr "Дополнительная PMT"

#: modules/codec/mft.cpp:83
