# Maintainer: code_warlord <code_warlord@proton.me>
pkgname=juxtopposed-vlc
pkgver=4.0.0.r1
pkgrel=1
pkgdesc="VLC media player with Juxtopposed redesign (Russian UI)"
arch=('x86_64')
url="https://github.com/code-warlord-dev/juxtopposed-vlc"
license=('GPL2')
depends=()
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'git' 'rust')
source=("git+https://github.com/code-warlord-dev/juxtopposed-vlc.git")
sha256sums=('SKIP')

build() {
  cd "$srcdir/juxtopposed-vlc"
  meson setup build --prefix=/usr -Dtests=disabled -Dprojectm=disabled
  ninja -C build
}

package() {
  cd "$srcdir/juxtopposed-vlc"
  DESTDIR="$pkgdir" ninja -C build install
  # Иконка
  install -Dm644 share/icons/256x256/vlc.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/vlc.png"
  # Desktop entry (русский интерфейс)
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/juxtopposed-vlc.desktop" <<EOF
[Desktop Entry]
Name=Медиапроигрыватель VLC (Juxtopposed)
GenericName=Медиапроигрыватель
Comment=Читает, записывает и транслирует мультимедиа
Exec=env LC_MESSAGES=ru_UA.UTF-8 /usr/bin/vlc %U
TryExec=/usr/bin/vlc
Icon=vlc
Terminal=false
Type=Application
Categories=AudioVideo;Player;
StartupWMClass=vlc
EOF
}
